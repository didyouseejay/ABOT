# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Personal editor settings (untracked files would mark the dashboard bundle's provenance as dirty)
.vscode/

# Data is re-downloadable via `abot fetch`; never commit it
data/
cache/
.ruff_cache/
.pytest_cache/
# JUnit report written by the CI test step (`pytest --junitxml=pytest-results.xml`)
pytest-results.xml

# Frontend (dashboard/) dependencies
node_modules/
# ...but not the dashboard source folder named data/ (the rule above matches any data/ directory)
!/dashboard/src/data/
